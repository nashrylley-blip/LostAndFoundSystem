@model LostAndFoundSystem.Models.RecycleBinViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Recycle Bin";

    string RangeLabel(string r) => r switch
    {
        "Today" => "Today",
        "7" => "Last 7 days",
        "30" => "Last 30 days",
        _ => "Any time"
    };
}

<style>
    .admin-page { max-width: 1500px; margin: 0 auto; padding: 28px 28px 50px; color: #17324d; }
    .page-header {
        position: relative; min-height: 180px; padding: 36px 42px; margin-bottom: 28px;
        border-radius: 28px; overflow: hidden;
        background: linear-gradient(135deg, #72d3ee 0%, #43b5df 55%, #159dcc 100%);
        box-shadow: 0 18px 38px rgba(24,145,188,.18); display: flex; align-items: center;
    }
    .page-header-content { position: relative; z-index: 2; color: white; }
    .page-header h1 { margin: 0 0 10px; font-size: 36px; font-weight: 900; letter-spacing: -.03em; }
    .page-header p { margin: 0; max-width: 680px; font-size: 14px; line-height: 1.7; color: rgba(255,255,255,.94); }

    .alert-success { background: #e8f8ef; color: #1a7a45; border: 1px solid #b8e6c9; padding: 14px 18px; border-radius: 14px; margin-bottom: 20px; font-weight: 600; }
    .alert-danger { background: #fdecea; color: #b42318; border: 1px solid #f5c2c0; padding: 14px 18px; border-radius: 14px; margin-bottom: 20px; font-weight: 600; }
    .retention-note {
        background: #fff8e8; color: #8a5a00; border: 1px solid #f3dfb0; padding: 12px 18px;
        border-radius: 14px; margin-bottom: 20px; font-size: 13px; font-weight: 600;
    }

    .bin-container {
        background: #fff; border: 1px solid #e7eef5; border-radius: 25px; padding: 28px;
        box-shadow: 0 8px 24px rgba(28,61,91,.05); margin-bottom: 24px;
    }

    /* Filters */
    .tabs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 18px; }
    .tab {
        padding: 10px 18px; border-radius: 12px; border: 1px solid #d0e0ec; background: white;
        font-weight: 700; font-size: 13px; color: #5a7388; text-decoration: none;
    }
    .tab:hover { background: #f3f9fd; color: #159dcc; }
    .tab.active { background: #159dcc; color: white; border-color: #159dcc; }
    .tab-count {
        display: inline-block; min-width: 20px; margin-left: 6px; padding: 1px 7px; border-radius: 999px;
        background: rgba(23,50,77,.08); font-size: 11px; text-align: center;
    }
    .tab.active .tab-count { background: rgba(255,255,255,.25); }

    .search-bar { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
    .search-input {
        flex: 1; min-width: 220px; padding: 11px 16px; border-radius: 12px; border: 1px solid #d0e0ec;
        font-size: 13px; color: #17324d; background: #f7fbfe;
    }
    .search-select {
        padding: 11px 16px; border-radius: 12px; border: 1px solid #d0e0ec;
        font-size: 13px; font-weight: 600; color: #17324d; background: #f7fbfe; cursor: pointer;
    }
    .btn-search {
        padding: 11px 22px; border-radius: 12px; border: none; background: #159dcc; color: white;
        font-weight: 800; font-size: 13px; cursor: pointer;
    }
    .btn-search:hover { background: #1189b3; }
    .btn-clear {
        padding: 11px 18px; border-radius: 12px; border: 1px solid #d0e0ec; background: white; color: #5a7388;
        font-weight: 700; font-size: 13px; text-decoration: none; display: inline-flex; align-items: center;
    }
    .btn-clear:hover { background: #f3f9fd; }

    /* List */
    .bin-count { font-size: 13px; color: #7890a4; margin-bottom: 14px; }
    .bin-list { display: flex; flex-direction: column; gap: 12px; }
    .bin-card {
        display: flex; gap: 16px; align-items: center; padding: 16px 18px;
        border: 1px solid #e0edf5; border-radius: 18px; background: #fbfdff;
    }
    .bin-thumb {
        width: 56px; height: 56px; border-radius: 12px; object-fit: cover; flex-shrink: 0;
        background: #eef3f8; border: 1px solid #e0edf5;
    }
    .bin-thumb-icon {
        width: 56px; height: 56px; border-radius: 12px; flex-shrink: 0; display: flex;
        align-items: center; justify-content: center; font-size: 22px; background: #eef3f8;
    }
    .bin-body { flex: 1; min-width: 0; }
    .bin-title-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 4px; }
    .bin-title { margin: 0; font-size: 15px; font-weight: 800; color: #17324d; }
    .badge {
        display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 10px; font-weight: 800;
        text-transform: uppercase; letter-spacing: .03em;
    }
    .badge-item { background: #e7f4ff; color: #1a6fb5; }
    .badge-notification { background: #f0eaff; color: #6a3fc4; }
    .badge-status { background: #eef3f8; color: #5a7388; }
    .bin-details {
        margin: 0 0 6px; font-size: 13px; color: #5a7388; line-height: 1.5;
        overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
    }
    .bin-meta { font-size: 12px; color: #94a8b8; font-weight: 600; }
    .days-left { font-weight: 800; color: #1a7a45; }
    .days-left.warn { color: #c47a0a; }
    .days-left.danger { color: #b42318; }
    .bin-actions { display: flex; gap: 8px; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; }
    .btn-sm {
        padding: 8px 14px; border-radius: 10px; font-size: 12px; font-weight: 700; border: none; cursor: pointer;
    }
    .btn-restore { background: #e8f8ef; color: #1a7a45; }
    .btn-restore:hover { background: #d1f0df; }
    .btn-perm { background: #fdecea; color: #b42318; }
    .btn-perm:hover { background: #f8d4d2; }

    .empty-state { text-align: center; padding: 60px 20px; color: #7890a4; }
    .empty-state h3 { margin: 0 0 8px; color: #17324d; font-weight: 800; }

    .back-button {
        display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 14px;
        background: #f0f7fc; color: #159dcc; font-weight: 800; font-size: 13px; text-decoration: none;
        border: 1px solid #d0e8f5;
    }
    .back-button:hover { background: #e3f2fb; }

    @@media (max-width: 700px) {
        .bin-card { flex-wrap: wrap; }
        .bin-actions { width: 100%; justify-content: flex-start; }
    }
</style>

<div class="admin-page">
    <div class="page-header">
        <div class="page-header-content">
            <h1>Recycle Bin</h1>
            <p>Deleted items and notifications are kept here. Restore them if you deleted by mistake, or delete them permanently.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="retention-note">
        Records in the Recycle Bin are permanently deleted after @Model.RetentionDays days.
    </div>

    <div class="bin-container">

        <!-- Type tabs -->
        <div class="tabs">
            <a asp-action="Index" asp-route-type="All" asp-route-q="@Model.Search" asp-route-range="@Model.Range"
               class="tab @(Model.Type == "All" ? "active" : "")">All<span class="tab-count">@Model.TotalCount</span></a>
            <a asp-action="Index" asp-route-type="Items" asp-route-q="@Model.Search" asp-route-range="@Model.Range"
               class="tab @(Model.Type == "Items" ? "active" : "")">Items<span class="tab-count">@Model.ItemsCount</span></a>
            <a asp-action="Index" asp-route-type="Notifications" asp-route-q="@Model.Search" asp-route-range="@Model.Range"
               class="tab @(Model.Type == "Notifications" ? "active" : "")">Notifications<span class="tab-count">@Model.NotificationsCount</span></a>
        </div>

        <!-- Search + date filter -->
        <form method="get" asp-action="Index" class="search-bar">
            <input type="hidden" name="type" value="@Model.Type" />
            <input type="text" name="q" value="@Model.Search" class="search-input" placeholder="Search deleted items and notifications..." />
            <select name="range" class="search-select">
                @foreach (var r in new[] { "Any", "Today", "7", "30" })
                {
                    if (Model.Range == r)
                    {
                        <option value="@r" selected>@RangeLabel(r)</option>
                    }
                    else
                    {
                        <option value="@r">@RangeLabel(r)</option>
                    }
                }
            </select>
            <button type="submit" class="btn-search">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search) || Model.Range != "Any")
            {
                <a asp-action="Index" asp-route-type="@Model.Type" class="btn-clear">Clear</a>
            }
        </form>

        @if (!Model.Entries.Any())
        {
            <div class="empty-state">
                <h3>@(string.IsNullOrEmpty(Model.Search) && Model.Range == "Any" ? "The Recycle Bin is empty" : "No results found")</h3>
                <p>@(string.IsNullOrEmpty(Model.Search) && Model.Range == "Any" ? "Deleted items and notifications will appear here." : "Try a different search or date range.")</p>
            </div>
        }
        else
        {
            <div class="bin-count">@Model.Entries.Count @(Model.Entries.Count == 1 ? "record" : "records")</div>

            <div class="bin-list">
                @foreach (var e in Model.Entries)
                {
                    <div class="bin-card">
                        @if (e.Kind == "Item" && !string.IsNullOrEmpty(e.ImageUrl))
                        {
                            <img src="@e.ImageUrl" alt="@e.Title" class="bin-thumb" />
                        }
                        else
                        {
                            <div class="bin-thumb-icon">
                                @(e.Kind == "Item" ? "📦" : (e.Badge switch { "Report" => "📋", "Claim" => "🔑", "Message" => "💬", _ => "🔔" }))
                            </div>
                        }

                        <div class="bin-body">
                            <div class="bin-title-row">
                                <h3 class="bin-title">@e.Title</h3>
                                <span class="badge @(e.Kind == "Item" ? "badge-item" : "badge-notification")">@e.Kind</span>
                                @if (!string.IsNullOrEmpty(e.Badge))
                                {
                                    <span class="badge badge-status">@e.Badge</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(e.Details))
                            {
                                <p class="bin-details">@e.Details</p>
                            }

                            <div class="bin-meta">
                                Deleted @e.DeletedAt.ToString("MMM dd, yyyy · hh:mm tt") by @e.DeletedBy ·
                                <span class="days-left @(e.DaysLeft <= 3 ? "danger" : (e.DaysLeft <= 7 ? "warn" : ""))">
                                    @e.DaysLeft @(e.DaysLeft == 1 ? "day" : "days") left
                                </span>
                            </div>
                        </div>

                        <div class="bin-actions">
                            <form asp-action="Restore" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="kind" value="@e.Kind" />
                                <input type="hidden" name="id" value="@e.Id" />
                                <input type="hidden" name="type" value="@Model.Type" />
                                <input type="hidden" name="q" value="@Model.Search" />
                                <input type="hidden" name="range" value="@Model.Range" />
                                <button type="submit" class="btn-sm btn-restore">Restore</button>
                            </form>

                            <form asp-action="DeletePermanently" method="post"
                                  onsubmit="return confirm('Delete this permanently? This cannot be undone.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="kind" value="@e.Kind" />
                                <input type="hidden" name="id" value="@e.Id" />
                                <input type="hidden" name="type" value="@Model.Type" />
                                <input type="hidden" name="q" value="@Model.Search" />
                                <input type="hidden" name="range" value="@Model.Range" />
                                <button type="submit" class="btn-sm btn-perm">Delete permanently</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <a asp-controller="Admin" asp-action="Index" class="back-button">
        <span>←</span> Back to Admin Dashboard
    </a>
</div>