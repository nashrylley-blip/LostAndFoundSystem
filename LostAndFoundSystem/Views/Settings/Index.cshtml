@model LostAndFoundSystem.Models.User

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Settings";
}

<style>
    .settings-page { max-width: 800px; margin: 0 auto; padding: 30px; color: #17324d; }
    .settings-header {
        background: linear-gradient(135deg, #72d3ee, #43b5df); color: white;
        border-radius: 28px; padding: 40px; margin-bottom: 28px;
        box-shadow: 0 12px 30px rgba(50,157,202,0.14);
    }
    .settings-header h1 { margin: 0 0 8px; font-size: 34px; font-weight: 900; }
    .settings-header p { margin: 0; opacity: .95; font-size: 15px; }
    .settings-card {
        background: white; border: 1px solid #e7eef5; border-radius: 24px; padding: 32px;
        box-shadow: 0 8px 24px rgba(28,61,91,.05); margin-bottom: 24px;
    }
    .settings-card h2 { margin: 0 0 20px; font-size: 20px; font-weight: 900; }
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 13px; font-weight: 800; color: #5a7388; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .03em; }
    .form-control {
        width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid #d0e0ec;
        font-size: 14px; color: #17324d; background: #f7fbfe; box-sizing: border-box;
    }
    .btn-save {
        padding: 12px 28px; border-radius: 12px; border: none; background: #159dcc; color: white;
        font-weight: 800; font-size: 14px; cursor: pointer;
    }
    .btn-save:hover { background: #1289b3; }
    .alert-success { background: #e8f8ef; color: #1a7a45; border: 1px solid #b8e6c9; padding: 14px 18px; border-radius: 14px; margin-bottom: 20px; font-weight: 600; }
    .alert-danger { background: #fdecea; color: #b42318; border: 1px solid #f5c2c0; padding: 14px 18px; border-radius: 14px; margin-bottom: 20px; font-weight: 600; }
    .back-button {
        display: inline-flex; align-items: center; gap: 8px; padding: 12px 22px; border-radius: 14px;
        background: #f0f7fc; color: #159dcc; font-weight: 800; font-size: 13px; text-decoration: none;
        border: 1px solid #d0e8f5;
    }
</style>

<div class="settings-page">
    <div class="settings-header">
        <h1>Settings</h1>
        <p>Update your profile information or change your password.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="settings-card">
        <h2>Update Profile</h2>
        <form asp-action="UpdateProfile" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Full Name</label>
                <input type="text" name="fullName" class="form-control" value="@Model.FullName" required />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" class="form-control" value="@Model.Email" required />
            </div>
            <button type="submit" class="btn-save">Save Profile</button>
        </form>
    </div>

    <div class="settings-card">
        <h2>Change Password</h2>
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Current Password</label>
                <input type="password" name="currentPassword" class="form-control" required />
            </div>
            <div class="form-group">
                <label>New Password</label>
                <input type="password" name="newPassword" class="form-control" minlength="6" required />
            </div>
            <div class="form-group">
                <label>Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-control" minlength="6" required />
            </div>
            <button type="submit" class="btn-save">Change Password</button>
        </form>
    </div>

    @{
        var backController = Model.Role == "Admin" ? "Admin" : "Home";
    }
    <a asp-controller="@backController" asp-action="Index" class="back-button">
        <span>←</span> Back to Dashboard
    </a>
</div>
