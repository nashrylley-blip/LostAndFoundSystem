@model LostAndFoundSystem.Models.VerifyEmailViewModel

@{
    Layout = null;
    ViewData["Title"] = "Verify Gmail";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Verify Gmail | Campus Lost &amp; Found</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 16px;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #173b5b;
            background-image: linear-gradient(135deg, rgba(5, 91, 125, 0.55), rgba(14, 156, 204, 0.40), rgba(71, 197, 229, 0.30)), url('/images/campus-bg.png');
            background-size: cover;
            background-position: center center;
            background-attachment: fixed;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        .card {
            width: 100%;
            max-width: 450px;
            background: #ffffff;
            border-radius: 24px;
            padding: 38px 36px 32px;
            box-shadow: 0 25px 60px rgba(8, 60, 85, 0.30);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 11px;
            margin-bottom: 22px;
        }

        .brand-logo {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #5fd0ef;
            color: #ffffff;
        }

            .brand-logo svg {
                width: 22px;
                height: 22px;
            }

        .brand-text {
            font-size: 17px;
            font-weight: 700;
            letter-spacing: -0.4px;
            color: #174b73;
        }

        h1 {
            font-size: 28px;
            color: #183e59;
            margin-bottom: 6px;
        }

        .subtitle {
            color: #8195a2;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 24px;
        }

            .subtitle strong {
                color: #36566c;
            }

        .form-group {
            margin-bottom: 16px;
        }

            .form-group label {
                display: block;
                color: #36566c;
                font-size: 12px;
                font-weight: 700;
                margin-bottom: 7px;
            }

        .code-input {
            width: 100%;
            height: 56px;
            border: 1px solid #dbe6ec;
            border-radius: 11px;
            outline: none;
            padding: 0 14px;
            color: #28465a;
            font-size: 26px;
            font-weight: 700;
            letter-spacing: 10px;
            text-align: center;
            background: #fcfeff;
            transition: 0.2s;
        }

            .code-input:focus {
                border-color: #159dcc;
                box-shadow: 0 0 0 3px rgba(21, 157, 204, 0.10);
            }

        .field-error {
            display: block;
            color: #c14444;
            font-size: 11px;
            margin-top: 6px;
        }

            .field-error:empty {
                display: none;
            }

        .error-message {
            background: #fff1f1;
            color: #c14444;
            border: 1px solid #ffd7d7;
            padding: 10px 12px;
            border-radius: 9px;
            font-size: 12px;
            margin-bottom: 16px;
        }

        .info-message {
            background: #effaf3;
            color: #1e7a46;
            border: 1px solid #c9ecd7;
            padding: 10px 12px;
            border-radius: 9px;
            font-size: 12px;
            margin-bottom: 16px;
        }

        .verify-btn {
            width: 100%;
            height: 48px;
            border: none;
            border-radius: 11px;
            background: linear-gradient(135deg, #087ea4, #159dcc);
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 9px 20px rgba(21, 157, 204, 0.25);
            transition: 0.2s;
        }

            .verify-btn:hover {
                transform: translateY(-1px);
                box-shadow: 0 12px 25px rgba(21, 157, 204, 0.32);
            }

        .resend-area {
            text-align: center;
            color: #899ba6;
            font-size: 12px;
            margin-top: 20px;
        }

        .link-btn {
            border: none;
            background: transparent;
            color: #108bc2;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
        }

            .link-btn:hover {
                text-decoration: underline;
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 10px;
            font-size: 12px;
            color: #108bc2;
            font-weight: 700;
        }

            .back-link:hover {
                text-decoration: underline;
            }

        @@media (max-width: 480px) {
            .card {
                padding: 30px 22px 26px;
            }

            h1 {
                font-size: 24px;
            }

            .code-input {
                letter-spacing: 6px;
            }
        }
    </style>
</head>

<body>

    <div class="card">

        <div class="brand">
            <div class="brand-logo">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="6.5"></circle>
                    <path d="M16 16L21 21"></path>
                </svg>
            </div>
            <div class="brand-text">Campus Lost &amp; Found</div>
        </div>

        <h1>Verify your Gmail</h1>

        <p class="subtitle">
            We sent a 6-digit code to <strong>@Model.Email</strong>.
            Enter it below to finish creating your account. The code expires in 10 minutes.
        </p>

        @if (ViewBag.Info != null)
        {
            <div class="info-message">@ViewBag.Info</div>
        }

        @if (ViewData.ModelState.TryGetValue(string.Empty, out var generalEntry) && generalEntry.Errors.Count > 0)
        {
            <div class="error-message">@generalEntry.Errors[0].ErrorMessage</div>
        }

        <form asp-controller="Account" asp-action="VerifyEmail" method="post" novalidate>

            <input type="hidden" asp-for="Email" />

            <div class="form-group">
                <label for="Code">Verification Code</label>
                <input asp-for="Code"
                       class="code-input"
                       type="text"
                       inputmode="numeric"
                       maxlength="6"
                       placeholder="000000"
                       autocomplete="one-time-code"
                       value="" />
                <span asp-validation-for="Code" class="field-error"></span>
            </div>

            <button type="submit" class="verify-btn">Verify &amp; Create Account</button>

        </form>

        <div class="resend-area">
            Didn't get the code?

            <form asp-controller="Account" asp-action="ResendCode" method="post" style="display:inline">
                <input type="hidden" name="email" value="@Model.Email" />
                <button type="submit" class="link-btn">Resend code</button>
            </form>
        </div>

        <a asp-controller="Account" asp-action="Register" class="back-link">Wrong Gmail? Go back</a>

    </div>

</body>
</html>
