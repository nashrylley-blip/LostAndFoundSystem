<!DOCTYPE html>
<html lang="en">
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@using LostAndFoundSystem.Data
@inject ApplicationDbContext Db

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Campus Lost &amp; Found System</title>
    <meta name="description" content="Campus Lost and Found System – report lost or found items, claim belongings, and message administrators." />
    <meta name="keywords" content="lost and found, campus, student, report lost item, claim item" />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content="Campus Lost & Found System" />
    <meta property="og:description" content="Report lost or found items and claim belongings on campus." />
    <meta property="og:type" content="website" />
    <link rel="canonical" href="@(Context.Request.Scheme)://@(Context.Request.Host)/" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: #f5f8fc;
                font-family: Arial, Helvetica, sans-serif;
                color: #172b4d;
            }


            /* =========================================
                       TOP BAR
                    ========================================== */

            .top-navbar {
                height: 72px;
                background: #ffffff;
                display: flex;
                align-items: center;
                padding: 0 28px;
                position: fixed;
                top: 0;
                left: 270px;
                right: 0;
                z-index: 1000;
                border-bottom: 1px solid #e6edf5;
                transition: left 0.3s ease;
            }

            .menu-button {
                width: 52px;
                height: 52px;
                border: none;
                background: #eef4f9;
                color: #183b56;
                border-radius: 14px;
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                transition: 0.2s ease;
            }

                .menu-button:hover {
                    background: #e2edf5;
                }

                .menu-button:active {
                    transform: scale(0.96);
                }

                .menu-button svg {
                    width: 25px;
                    height: 25px;
                }


            /* =========================================
                       TOP PROFILE
                    ========================================== */

            .nav-right {
                margin-left: auto;
                display: flex;
                align-items: center;
            }

            .top-profile {
                display: flex;
                align-items: center;
                gap: 9px;
                padding: 4px 7px 4px 4px;
                text-decoration: none;
                color: #172b4d;
                border-radius: 22px;
                transition: 0.2s ease;
            }

                .top-profile:hover {
                    background: #f3f7fb;
                }

            .top-profile-avatar {
                width: 40px;
                height: 40px;
                border-radius: 50%;
                background: #e5eff9;
                color: #6685a2;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 16px;
                font-weight: 700;
            }

            .top-profile-name {
                font-size: 14px;
                font-weight: 700;
                color: #172b4d;
            }

            .top-profile-arrow {
                font-size: 13px;
                color: #4d8ab5;
                margin-left: 1px;
            }


            /* =========================================
                       TOP BAR ICON BUTTONS (NOTIFICATIONS / MESSAGES)
                    ========================================== */

            .top-icon-button {
                width: 42px;
                height: 42px;
                margin-right: 4px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #4d6a84;
                text-decoration: none;
                transition: 0.2s ease;
            }

                .top-icon-button:hover {
                    background: #f3f7fb;
                    color: #238ed0;
                }

                .top-icon-button.active {
                    background: #e5eff9;
                    color: #238ed0;
                }

                .top-icon-button {
                    position: relative;
                }

                .top-icon-button svg {
                    width: 22px;
                    height: 22px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

                .icon-badge {
                    position: absolute;
                    top: 2px;
                    right: 2px;
                    min-width: 18px;
                    height: 18px;
                    padding: 0 5px;
                    border-radius: 999px;
                    background: #e11d48;
                    color: #fff;
                    font-size: 10px;
                    font-weight: 800;
                    line-height: 18px;
                    text-align: center;
                    box-shadow: 0 0 0 2px #fff;
                    pointer-events: none;
                }


            /* =========================================
                       PROFILE DROPDOWN (STUDENT)
                    ========================================== */

            button.top-profile {
                background: transparent;
                border: none;
                cursor: pointer;
                font-family: inherit;
            }

            .profile-dropdown {
                position: relative;
            }

            .top-profile-arrow {
                transition: transform 0.2s ease;
            }

            .profile-dropdown.open .top-profile-arrow {
                transform: rotate(180deg);
            }

            .profile-dropdown.open .top-profile {
                background: #f3f7fb;
            }

            .profile-menu {
                display: none;
                position: absolute;
                top: calc(100% + 10px);
                right: 0;
                min-width: 205px;
                background: #ffffff;
                border: 1px solid #e6edf5;
                border-radius: 14px;
                box-shadow: 0 14px 32px rgba(22, 50, 80, 0.14);
                padding: 6px;
                z-index: 1200;
            }

            .profile-dropdown.open .profile-menu {
                display: block;
            }

            .profile-menu-item {
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 10px 12px;
                border-radius: 9px;
                color: #35506a;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                transition: 0.2s ease;
            }

                .profile-menu-item:hover {
                    background: #f3f7fb;
                    color: #238ed0;
                }

                .profile-menu-item.active {
                    background: #e5eff9;
                    color: #238ed0;
                }

                .profile-menu-item.logout:hover {
                    background: #fff5f5;
                    color: #c85b5b;
                }

                .profile-menu-item svg {
                    width: 19px;
                    height: 19px;
                    flex-shrink: 0;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .profile-menu-divider {
                height: 1px;
                background: #edf2f6;
                margin: 6px 4px;
            }


            /* =========================================
                       SIDEBAR
                    ========================================== */

            .sidebar {
                position: fixed;
                left: 0;
                top: 0;
                bottom: 0;
                width: 270px;
                background: linear-gradient(180deg, #132b49 0%, #102541 100%);
                padding: 20px 13px;
                z-index: 1100;
                overflow-y: auto;
                transition: width 0.3s ease, transform 0.3s ease;
            }


                /* =========================================
                       COLLAPSED SIDEBAR
                    ========================================== */

                .sidebar.collapsed {
                    width: 0;
                    padding-left: 0;
                    padding-right: 0;
                    overflow: hidden;
                }

            .top-navbar.sidebar-collapsed {
                left: 0;
            }

            .main-content.sidebar-collapsed {
                margin-left: 0;
            }

            .footer.sidebar-collapsed {
                margin-left: 0;
            }


            /* =========================================
                       BRAND
                    ========================================== */

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 3px 10px 28px;
                color: white;
                white-space: nowrap;
            }

            .brand-logo {
                width: 48px;
                height: 48px;
                border-radius: 50%;
                background: #238ed0;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                box-shadow: 0 5px 15px rgba(35, 142, 208, 0.3);
                flex-shrink: 0;
            }

                .brand-logo svg {
                    width: 29px;
                    height: 29px;
                    fill: none;
                    stroke: white;
                    stroke-width: 2.2;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .brand-text {
                display: flex;
                flex-direction: column;
            }

            .brand-name {
                font-size: 17px;
                font-weight: 800;
                line-height: 1.2;
                white-space: nowrap;
            }


            /* =========================================
                       SIDEBAR TITLE
                    ========================================== */

            .sidebar-title {
                font-size: 10px;
                font-weight: 700;
                color: #8098b0;
                padding: 0 13px;
                margin-bottom: 8px;
                text-transform: uppercase;
                letter-spacing: 1.2px;
            }


            /* =========================================
                       SIDEBAR LINKS
                    ========================================== */

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 12px;
                margin-bottom: 4px;
                border-radius: 9px;
                color: #c4d2df;
                text-decoration: none;
                font-size: 14px;
                font-weight: 600;
                transition: 0.2s ease;
            }

                .sidebar-link:hover {
                    background: rgba(255,255,255,0.08);
                    color: white;
                }

                .sidebar-link.active {
                    background: #238ed0;
                    color: white;
                    box-shadow: 0 5px 14px rgba(35, 142, 208, 0.25);
                }

            .sidebar-icon {
                width: 24px;
                height: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .sidebar-icon svg {
                    width: 19px;
                    height: 19px;
                    fill: none;
                    stroke: currentColor;
                    stroke-width: 1.8;
                    stroke-linecap: round;
                    stroke-linejoin: round;
                }

            .sidebar-divider {
                height: 1px;
                background: rgba(255,255,255,0.10);
                margin: 18px 8px;
            }


            /* =========================================
                       MAIN CONTENT
                    ========================================== */

            .main-content {
                margin-left: 270px;
                padding-top: 72px;
                min-height: calc(100vh - 72px);
                transition: margin-left 0.3s ease;
            }


            /* =========================================
                       FOOTER
                    ========================================== */

            .footer {
                margin-left: 270px;
                background: white;
                border-top: 1px solid #e6edf5;
                padding: 18px;
                text-align: center;
                color: #8da0b2;
                font-size: 12px;
                transition: margin-left 0.3s ease;
            }


            /* =========================================
                       SVG
                    ========================================== */

            .icon-svg {
                width: 21px;
                height: 21px;
                fill: none;
                stroke: currentColor;
                stroke-width: 1.9;
                stroke-linecap: round;
                stroke-linejoin: round;
            }


            /* =========================================
                       RESPONSIVE
                    ========================================== */

            @@media (max-width: 900px) {

                .top-navbar {
                    left: 0;
                }

                .sidebar {
                    width: 270px;
                    transform: translateX(-100%);
                }

                    .sidebar.show {
                        transform: translateX(0);
                    }

                    .sidebar.collapsed {
                        width: 270px;
                        padding-left: 13px;
                        padding-right: 13px;
                        transform: translateX(-100%);
                    }

                .top-navbar.sidebar-collapsed {
                    left: 0;
                }

                .main-content {
                    margin-left: 0;
                }

                    .main-content.sidebar-collapsed {
                        margin-left: 0;
                    }

                .footer {
                    margin-left: 0;
                }

                    .footer.sidebar-collapsed {
                        margin-left: 0;
                    }
            }


            @@media (max-width: 600px) {

                .top-navbar {
                    height: 65px;
                    padding: 0 15px;
                }

                .main-content {
                    padding-top: 65px;
                }

                .top-profile-name {
                    display: none;
                }

                .top-profile-arrow {
                    display: none;
                }

                .top-profile-avatar {
                    width: 36px;
                    height: 36px;
                }

                .top-icon-button {
                    width: 38px;
                    height: 38px;
                }

                .sidebar {
                    width: 250px;
                }

                    .sidebar.collapsed {
                        width: 250px;
                    }
            }

    </style>

</head>


<body>


    <!-- =========================================
         CURRENT PAGE
    ========================================== -->
    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var currentAction =
            ViewContext.RouteData.Values["action"]?.ToString();

        int unreadNotifications = 0;
        int unreadMessages = 0;

        if (User?.Identity?.IsAuthenticated == true)
        {
            var idClaim = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (int.TryParse(idClaim, out int uid))
            {
                bool isAdminUser = User.IsInRole("Admin");

                if (isAdminUser)
                {
                    // Admin bell: Reports & Claims only (student messages go to the envelope)
                    unreadNotifications = Db.Notifications
                        .Count(n => n.UserID == uid && !n.IsRead && n.Type != "Message");

                    // Unread messages from students in any conversation
                    unreadMessages = Db.ChatMessages
                        .Count(m => !m.IsRead
                            && m.Conversation != null
                            && m.SenderUserID == m.Conversation.StudentUserID);
                }
                else
                {
                    unreadNotifications = Db.Notifications
                        .Count(n => n.UserID == uid && !n.IsRead);

                    // Unread replies from admin in student's conversations
                    unreadMessages = Db.ChatMessages
                        .Count(m => !m.IsRead
                            && m.Conversation != null
                            && m.Conversation.StudentUserID == uid
                            && m.SenderUserID != uid);
                }
            }
        }
    }


    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <aside class="sidebar" id="sidebar">


        <!-- BRAND -->

        <div class="brand">

            <div class="brand-logo">

                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="10.5" cy="10.5" r="6.5"></circle>
                    <path d="M16 16l5 5"></path>
                </svg>

            </div>


            <div class="brand-text">

                <div class="brand-name">
                    Lost &amp; Found
                </div>

            </div>

        </div>


        @if (User.IsInRole("Admin"))
        {

            <!-- =================================
                 ADMIN MENU
            ================================== -->

            <div class="sidebar-title">
                Main Menu
            </div>


            <!-- Dashboard -->

            <a asp-controller="Admin"
               asp-action="Index"
               class="sidebar-link @(currentController == "Admin" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 10.5 12 3l9 7.5"></path>
                        <path d="M5 9.5V21h14V9.5"></path>
                        <path d="M9 21v-6h6v6"></path>
                    </svg>
                </span>

                <span>Dashboard</span>

            </a>


            <!-- Manage Reports -->

            <a asp-controller="ManageReports"
               asp-action="Index"
               class="sidebar-link @(currentController == "ManageReports" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                        <path d="M8 8h8"></path>
                        <path d="M8 12h8"></path>
                        <path d="M8 16h5"></path>
                    </svg>
                </span>

                <span>Manage Reports</span>

            </a>


            <!-- Manage Items -->

            <a asp-controller="ManageItems"
               asp-action="Index"
               class="sidebar-link @(currentController == "ManageItems" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M4 7 12 3l8 4-8 4-8-4Z"></path>
                        <path d="M4 7v10l8 4 8-4V7"></path>
                        <path d="M12 11v10"></path>
                    </svg>
                </span>

                <span>Manage Items</span>

            </a>


            <!-- Manage Users -->

            <a asp-controller="ManageUsers"
               asp-action="Index"
               class="sidebar-link @(currentController == "ManageUsers" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="9" cy="8" r="3"></circle>
                        <circle cx="17" cy="9" r="2.5"></circle>
                        <path d="M3 20c0-3.2 2.5-5 6-5s6 1.8 6 5"></path>
                        <path d="M15 15c3 0 5 1.5 5 4"></path>
                    </svg>
                </span>

                <span>Manage Users</span>

            </a>


            <!-- Recycle Bin -->

            <a asp-controller="RecycleBin"
               asp-action="Index"
               class="sidebar-link @(currentController == "RecycleBin" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 6h18"></path>
                        <path d="M8 6V4h8v2"></path>
                        <path d="M6 6l1 14h10l1-14"></path>
                        <path d="M10 11v5"></path>
                        <path d="M14 11v5"></path>
                    </svg>
                </span>

                <span>Recycle Bin</span>

            </a>

        }
        else
        {

            <!-- =================================
                 STUDENT MENU
            ================================== -->

            <div class="sidebar-title">
                Main Menu
            </div>


            <!-- Dashboard -->

            <a asp-controller="Home"
               asp-action="Index"
               class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 10.5 12 3l9 7.5"></path>
                        <path d="M5 9.5V21h14V9.5"></path>
                        <path d="M9 21v-6h6v6"></path>
                    </svg>
                </span>

                <span>Dashboard</span>

            </a>


            <!-- Find Items -->

            <a asp-controller="Find"
               asp-action="Index"
               class="sidebar-link @(currentController == "Find" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <circle cx="10.5" cy="10.5" r="6.5"></circle>
                        <path d="m16 16 5 5"></path>
                    </svg>
                </span>

                <span>Find Items</span>

            </a>


            <!-- Report Lost -->

            <a asp-controller="ReportLost"
               asp-action="Index"
               class="sidebar-link @(currentController == "ReportLost" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <rect x="4" y="3" width="16" height="18" rx="2"></rect>
                        <path d="M8 8h5"></path>
                        <path d="M8 12h8"></path>
                        <path d="M8 16h5"></path>
                        <path d="m16 7 2 2"></path>
                    </svg>
                </span>

                <span>Report Lost</span>

            </a>


            <!-- Report Found -->

            <a asp-controller="ReportFound"
               asp-action="Index"
               class="sidebar-link @(currentController == "ReportFound" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M4 7 12 3l8 4-8 4-8-4Z"></path>
                        <path d="M4 7v10l8 4 8-4V7"></path>
                        <path d="M12 11v10"></path>
                    </svg>
                </span>

                <span>Report Found</span>

            </a>


            <!-- My Reports -->

            <a asp-controller="MyReports"
               asp-action="Index"
               class="sidebar-link @(currentController == "MyReports" && currentAction == "Index" ? "active" : "")">

                <span class="sidebar-icon">
                    <svg viewBox="0 0 24 24">
                        <rect x="5" y="3" width="14" height="18" rx="2"></rect>
                        <path d="M9 8h6"></path>
                        <path d="M9 12h6"></path>
                        <path d="M9 16h4"></path>
                    </svg>
                </span>

                <span>My Reports</span>

            </a>

        }

    </aside>


    <!-- =========================================
         TOP NAVBAR
    ========================================== -->

    <header class="top-navbar">

        <button class="menu-button"
                type="button"
                onclick="toggleSidebar()"
                aria-label="Toggle menu">

            <svg viewBox="0 0 24 24" class="icon-svg">
                <line x1="4" y1="6" x2="20" y2="6"></line>
                <line x1="4" y1="12" x2="20" y2="12"></line>
                <line x1="4" y1="18" x2="20" y2="18"></line>
            </svg>

        </button>


        <!-- =========================================
             SMALL PROFILE
        ========================================== -->

        <div class="nav-right">

            @if (User.IsInRole("Admin"))
            {

                <!-- Notifications -->

                <a asp-controller="AdminNotifications"
                   asp-action="Index"
                   class="top-icon-button @(currentController == "AdminNotifications" && currentAction == "Index" ? "active" : "")"
                   title="Notifications"
                   aria-label="Notifications">

                    <svg viewBox="0 0 24 24">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                        <path d="M10 21h4"></path>
                    </svg>
                    @if (unreadNotifications > 0)
                    {
                        <span class="icon-badge">@(unreadNotifications > 99 ? "99+" : unreadNotifications.ToString())</span>
                    }

                </a>


                <!-- Messages -->

                <a asp-controller="AdminMessages"
                   asp-action="Index"
                   class="top-icon-button @(currentController == "AdminMessages" && currentAction == "Index" ? "active" : "")"
                   title="Messages"
                   aria-label="Messages">

                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="14" rx="3"></rect>
                        <path d="m4 7 8 6 8-6"></path>
                    </svg>
                    @if (unreadMessages > 0)
                    {
                        <span class="icon-badge">@(unreadMessages > 99 ? "99+" : unreadMessages.ToString())</span>
                    }

                </a>


                <!-- Profile Dropdown -->

                <div class="profile-dropdown" id="profileDropdown">

                    <button type="button"
                            class="top-profile"
                            id="profileToggle"
                            title="Account"
                            aria-haspopup="true"
                            aria-expanded="false">

                        <div class="top-profile-avatar">
                            A
                        </div>

                        <span class="top-profile-name">
                            Administrator
                        </span>

                        <span class="top-profile-arrow">
                            ˅
                        </span>

                    </button>


                    <div class="profile-menu">

                        <!-- Settings -->

                        <a asp-controller="AdminSettings"
                           asp-action="Index"
                           class="profile-menu-item @(currentController == "AdminSettings" && currentAction == "Index" ? "active" : "")">

                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V20h-2.6v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.5-1H6v-2.6h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1L9 6.6l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.5V5h2.6v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0-1.5 1h-.1V14h-.1a1.7 1.7 0 0 0-1.5 1Z"></path>
                            </svg>

                            <span>Settings</span>

                        </a>


                        <div class="profile-menu-divider"></div>


                        <!-- Logout -->

                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="profile-menu-item logout"
                           onclick="return confirm('Are you sure you want to logout?');">

                            <svg viewBox="0 0 24 24">
                                <path d="M10 4H5v16h5"></path>
                                <path d="M14 8l4 4-4 4"></path>
                                <path d="M18 12H9"></path>
                            </svg>

                            <span>Logout</span>

                        </a>

                    </div>

                </div>

            }
            else
            {

                <!-- Notifications -->

                <a asp-controller="Notifications"
                   asp-action="Index"
                   class="top-icon-button @(currentController == "Notifications" && currentAction == "Index" ? "active" : "")"
                   title="Notifications"
                   aria-label="Notifications">

                    <svg viewBox="0 0 24 24">
                        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                        <path d="M10 21h4"></path>
                    </svg>
                    @if (unreadNotifications > 0)
                    {
                        <span class="icon-badge">@(unreadNotifications > 99 ? "99+" : unreadNotifications.ToString())</span>
                    }

                </a>


                <!-- Messages -->

                <a asp-controller="Messages"
                   asp-action="Index"
                   class="top-icon-button @(currentController == "Messages" && currentAction == "Index" ? "active" : "")"
                   title="Messages"
                   aria-label="Messages">

                    <svg viewBox="0 0 24 24">
                        <rect x="3" y="5" width="18" height="14" rx="3"></rect>
                        <path d="m4 7 8 6 8-6"></path>
                    </svg>
                    @if (unreadMessages > 0)
                    {
                        <span class="icon-badge">@(unreadMessages > 99 ? "99+" : unreadMessages.ToString())</span>
                    }

                </a>


                <!-- Profile Dropdown -->

                <div class="profile-dropdown" id="profileDropdown">

                    <button type="button"
                            class="top-profile"
                            id="profileToggle"
                            title="Account"
                            aria-haspopup="true"
                            aria-expanded="false">

                        <div class="top-profile-avatar">
                            S
                        </div>

                        <span class="top-profile-name">
                            Student
                        </span>

                        <span class="top-profile-arrow">
                            ˅
                        </span>

                    </button>


                    <div class="profile-menu">

                        <!-- My Profile -->

                        <a asp-controller="Profile"
                           asp-action="Index"
                           class="profile-menu-item @(currentController == "Profile" && currentAction == "Index" ? "active" : "")">

                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="8" r="3.5"></circle>
                                <path d="M5 21c.5-4 3-6 7-6s6.5 2 7 6"></path>
                            </svg>

                            <span>My Profile</span>

                        </a>


                        <!-- Settings -->

                        <a asp-controller="Settings"
                           asp-action="Index"
                           class="profile-menu-item @(currentController == "Settings" && currentAction == "Index" ? "active" : "")">

                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="3"></circle>
                                <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-1.8 1.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V20h-2.6v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1-1.8-1.8.1-.1A1.7 1.7 0 0 0 8 15a1.7 1.7 0 0 0-1.5-1H6v-2.6h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1L9 6.6l.1.1a1.7 1.7 0 0 0 1.9.3 1.7 1.7 0 0 0 1-1.5V5h2.6v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1 1.8 1.8-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0-1.5 1h-.1V14h-.1a1.7 1.7 0 0 0-1.5 1Z"></path>
                            </svg>

                            <span>Settings</span>

                        </a>


                        <div class="profile-menu-divider"></div>


                        <!-- Logout -->

                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="profile-menu-item logout"
                           onclick="return confirm('Are you sure you want to logout?');">

                            <svg viewBox="0 0 24 24">
                                <path d="M10 4H5v16h5"></path>
                                <path d="M14 8l4 4-4 4"></path>
                                <path d="M18 12H9"></path>
                            </svg>

                            <span>Logout</span>

                        </a>

                    </div>

                </div>

            }

        </div>

    </header>


    <!-- =========================================
         MAIN CONTENT
    ========================================== -->

    <main class="main-content">

        @RenderBody()

    </main>


    <!-- =========================================
         FOOTER
    ========================================== -->

    <footer class="footer">

        <div>
            © 2026 Lost &amp; Found System
        </div>

        <div>
            Campus Lost &amp; Found Management System
        </div>

    </footer>


    <!-- =========================================
         SIDEBAR SCRIPT
    ========================================== -->

    <script>

            function toggleSidebar() {

                const sidebar =
                    document.getElementById("sidebar");

                const navbar =
                    document.querySelector(".top-navbar");

                const mainContent =
                    document.querySelector(".main-content");

                const footer =
                    document.querySelector(".footer");


                /* =====================================
                   MOBILE
                ===================================== */

                if (window.innerWidth <= 900) {

                    sidebar.classList.toggle("show");

                    return;
                }


                /* =====================================
                   DESKTOP
                ===================================== */

                sidebar.classList.toggle("collapsed");

                navbar.classList.toggle("sidebar-collapsed");

                mainContent.classList.toggle("sidebar-collapsed");

                footer.classList.toggle("sidebar-collapsed");

            }


            /* =========================================
               HANDLE WINDOW RESIZE
            ========================================== */

            window.addEventListener("resize", function() {

                const sidebar =
                    document.getElementById("sidebar");

                const navbar =
                    document.querySelector(".top-navbar");

                const mainContent =
                    document.querySelector(".main-content");

                const footer =
                    document.querySelector(".footer");


                if (window.innerWidth <= 900) {

                    navbar.classList.remove("sidebar-collapsed");

                    mainContent.classList.remove("sidebar-collapsed");

                    footer.classList.remove("sidebar-collapsed");

                }
                else {

                    sidebar.classList.remove("show");

                }

            });

    </script>


    <!-- =========================================
         PROFILE DROPDOWN SCRIPT
    ========================================== -->

    <script>

            (function () {

                const dropdown =
                    document.getElementById("profileDropdown");

                if (!dropdown) {
                    return;
                }

                const toggle =
                    document.getElementById("profileToggle");


                function closeMenu() {

                    dropdown.classList.remove("open");

                    toggle.setAttribute("aria-expanded", "false");

                }


                toggle.addEventListener("click", function () {

                    const isOpen =
                        dropdown.classList.toggle("open");

                    toggle.setAttribute("aria-expanded", isOpen);

                });


                document.addEventListener("click", function (e) {

                    if (!dropdown.contains(e.target)) {
                        closeMenu();
                    }

                });


                document.addEventListener("keydown", function (e) {

                    if (e.key === "Escape") {
                        closeMenu();
                    }

                });

            })();

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
