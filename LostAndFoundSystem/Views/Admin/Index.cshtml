@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    .admin-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px 28px 50px;
        color: #17324d;
    }

    /* =========================
       HERO
       ========================= */

    .admin-hero {
        position: relative;
        min-height: 220px;
        padding: 36px 42px;
        margin-bottom: 28px;
        border-radius: 28px;
        overflow: hidden;

        background:
            radial-gradient(
                circle at 92% 10%,
                rgba(255,255,255,.22),
                transparent 25%
            ),
            radial-gradient(
                circle at 78% 100%,
                rgba(255,255,255,.13),
                transparent 25%
            ),
            linear-gradient(
                135deg,
                #72d3ee 0%,
                #43b5df 55%,
                #159dcc 100%
            );

        box-shadow: 0 18px 38px rgba(24, 145, 188, .18);

        display: flex;
        align-items: center;
    }

    .admin-hero::before {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        right: -65px;
        top: -105px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.22);
    }

    .admin-hero::after {
        content: "";
        position: absolute;
        width: 175px;
        height: 175px;
        right: 130px;
        bottom: -115px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.18);
    }

    .admin-hero-content {
        position: relative;
        z-index: 2;
        color: white;
        max-width: 850px;
    }

    .admin-hero-title {
        display: flex;
        align-items: center;
        gap: 16px;
        margin: 0;
        font-size: 42px;
        line-height: 1.1;
        font-weight: 900;
        letter-spacing: -.03em;
    }

    .admin-hero-icon {
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        border-radius: 16px;
        background: rgba(255,255,255,.17);
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(4px);
    }

    .admin-hero-icon svg {
        width: 28px;
        height: 28px;
    }

    .admin-hero-subtitle {
        margin: 15px 0 0;
        font-size: 18px;
        line-height: 1.6;
        font-weight: 600;
        color: rgba(255,255,255,.95);
    }

    /* =========================
       ADMINISTRATION SECTION
       ========================= */

    .admin-section {
        background: #ffffff;
        border: 1px solid #e7eef5;
        border-radius: 25px;
        padding: 28px;
        margin-bottom: 24px;
        box-shadow: 0 8px 24px rgba(28, 61, 91, .05);
    }

    .section-title {
        margin: 0;
        font-size: 25px;
        font-weight: 900;
        color: #17324d;
    }

    .section-description {
        margin: 6px 0 24px;
        font-size: 14px;
        line-height: 1.6;
        color: #7890a4;
    }

    /* =========================
       ADMIN CARDS
       ========================= */

    .admin-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .admin-card {
        position: relative;
        min-height: 220px;
        padding: 30px;
        border-radius: 22px;
        background: #ffffff;
        border: 1px solid #dce8f1;
        text-decoration: none;
        color: #17324d;
        overflow: hidden;

        display: flex;
        flex-direction: column;
        justify-content: space-between;

        transition:
            transform .18s ease,
            box-shadow .18s ease,
            border-color .18s ease;
    }

    .admin-card::after {
        content: "";
        position: absolute;
        width: 110px;
        height: 110px;
        right: -25px;
        bottom: -38px;
        border-radius: 50%;
        background: #f1f8fc;
    }

    .admin-card:hover {
        transform: translateY(-4px);
        border-color: #b9e4f2;
        box-shadow: 0 14px 30px rgba(28, 61, 91, .10);
    }

    .admin-card-content {
        position: relative;
        z-index: 2;
    }

    .admin-card-icon {
        width: 56px;
        height: 56px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 23px;
    }

    .admin-card-icon svg {
        width: 28px;
        height: 28px;
    }

    .reports-icon {
        background: #e7f4ff;
        color: #268ddc;
    }

    .items-icon {
        background: #fff3df;
        color: #e89114;
    }

    .users-icon {
        background: #f0eaff;
        color: #7653dc;
    }

    .admin-card-title {
        margin-bottom: 7px;
        font-size: 18px;
        font-weight: 900;
        color: #17324d;
    }

    .admin-card-description {
        max-width: 360px;
        font-size: 13px;
        line-height: 1.65;
        color: #71879a;
    }

    .admin-card-arrow {
        position: relative;
        z-index: 3;
        margin-top: 20px;
        font-size: 12px;
        font-weight: 850;
        color: #159dcc;
    }

    /* =========================
       SYSTEM STATUS
       ========================= */

    .system-status-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-top: 8px;
    }

    .status-item {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        border: 1px solid #e5edf3;
        border-radius: 17px;
        background: #fbfdff;
    }

    .status-icon {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
        border-radius: 14px;
        background: #e9f8fc;
        color: #159dcc;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .status-icon svg {
        width: 22px;
        height: 22px;
    }

    .status-text {
        min-width: 0;
    }

    .status-title {
        font-size: 13px;
        font-weight: 850;
        color: #17324d;
        margin-bottom: 3px;
    }

    .status-description {
        font-size: 11px;
        color: #8497a8;
        line-height: 1.5;
    }

    .status-badge {
        margin-left: auto;
        flex: 0 0 auto;
        padding: 6px 10px;
        border-radius: 999px;
        background: #e9f8ef;
        color: #31945d;
        font-size: 10px;
        font-weight: 850;
    }

    /* =========================
       ADMIN REMINDER
       ========================= */

    .admin-reminder {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 22px;
        margin-top: 24px;
        border-radius: 20px;

        background:
            radial-gradient(
                circle at 90% 20%,
                rgba(255,255,255,.25),
                transparent 28%
            ),
            linear-gradient(
                135deg,
                #e8f9fd,
                #dff4fa
            );

        border: 1px solid #cbeef6;
    }

    .reminder-icon {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        border-radius: 14px;
        background: rgba(255,255,255,.75);
        color: #159dcc;

        display: flex;
        align-items: center;
        justify-content: center;
    }

    .reminder-icon svg {
        width: 23px;
        height: 23px;
    }

    .reminder-text strong {
        display: block;
        margin-bottom: 4px;
        font-size: 13px;
        font-weight: 850;
        color: #17324d;
    }

    .reminder-text span {
        display: block;
        font-size: 12px;
        line-height: 1.55;
        color: #688096;
    }

    /* =========================
       LOGOUT
       ========================= */

    .admin-logout {
        display: flex;
        justify-content: flex-end;
        margin-top: 24px;
    }

    .logout-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 18px;
        border-radius: 12px;
        background: #ffffff;
        border: 1px solid #dfe8ef;
        color: #647b8f;
        text-decoration: none;
        font-size: 12px;
        font-weight: 800;

        transition:
            background .18s ease,
            color .18s ease,
            border-color .18s ease;
    }

    .logout-button svg {
        width: 17px;
        height: 17px;
    }

    .logout-button:hover {
        background: #fff5f5;
        border-color: #f0cccc;
        color: #c85b5b;
    }

    /* =========================
       RESPONSIVE
       ========================= */

    @@media (max-width: 1100px) {
        .admin-actions {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .system-status-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 750px) {
        .admin-page {
            padding: 22px 18px 40px;
        }

        .admin-hero {
            min-height: auto;
            padding: 30px 26px;
            border-radius: 23px;
        }

        .admin-hero-title {
            font-size: 34px;
        }

        .admin-hero-subtitle {
            font-size: 15px;
        }

        .admin-section {
            padding: 22px;
        }

        .admin-actions {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 480px) {
        .admin-page {
            padding: 18px 14px 35px;
        }

        .admin-hero {
            padding: 25px 20px;
        }

        .admin-hero-title {
            gap: 11px;
            font-size: 28px;
        }

        .admin-hero-icon {
            width: 45px;
            height: 45px;
            flex-basis: 45px;
        }

        .admin-hero-icon svg {
            width: 23px;
            height: 23px;
        }

        .admin-section {
            padding: 18px;
        }

        .section-title {
            font-size: 21px;
        }

        .admin-card {
            min-height: 205px;
            padding: 23px;
        }

        .admin-reminder {
            align-items: flex-start;
        }

        .admin-logout {
            justify-content: stretch;
        }

        .logout-button {
            width: 100%;
        }
    }
</style>


<div class="admin-page">

    <!-- HERO -->
    <section class="admin-hero">

        <div class="admin-hero-content">

            <h1 class="admin-hero-title">

                <span class="admin-hero-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z" />
                        <path d="M9 12l2 2 4-4" />

                    </svg>
                </span>

                Admin Dashboard

            </h1>

            <p class="admin-hero-subtitle"
            </p>

        </div>

    </section>


    <!-- ADMINISTRATION -->
    <section class="admin-section">

        <h2 class="section-title">
            Administration
        </h2>

        <p class="section-description">
            Access the main management areas of the system.
        </p>


        <div class="admin-actions">

            <!-- MANAGE REPORTS -->
            <a asp-controller="ManageReports"
               asp-action="Index"
               class="admin-card">

                <div class="admin-card-content">

                    <div class="admin-card-icon reports-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M6 3h9l3 3v15H6z" />
                            <path d="M15 3v4h4" />
                            <path d="M9 11h6" />
                            <path d="M9 15h6" />
                            <path d="M9 19h4" />

                        </svg>

                    </div>

                    <div class="admin-card-title">
                        Manage Reports
                    </div>

                    <div class="admin-card-description">
                        Review and manage lost and found reports submitted by students.
                    </div>

                </div>

                <div class="admin-card-arrow">
                    Open Reports →
                </div>

            </a>


            <!-- MANAGE ITEMS -->
            <a asp-controller="ManageItems"
               asp-action="Index"
               class="admin-card">

                <div class="admin-card-content">

                    <div class="admin-card-icon items-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M21 8l-9-5-9 5 9 5 9-5z" />
                            <path d="M3 8v9l9 5 9-5V8" />
                            <path d="M12 13v9" />
                            <path d="M7.5 5.5l9 5" />

                        </svg>

                    </div>

                    <div class="admin-card-title">
                        Manage Items
                    </div>

                    <div class="admin-card-description">
                        Manage the lost and found items recorded in the system.
                    </div>

                </div>

                <div class="admin-card-arrow">
                    Open Items →
                </div>

            </a>


            <!-- MANAGE USERS -->
            <a asp-controller="ManageUsers"
               asp-action="Index"
               class="admin-card">

                <div class="admin-card-content">

                    <div class="admin-card-icon users-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round">

                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />

                        </svg>

                    </div>

                    <div class="admin-card-title">
                        Manage Users
                    </div>

                    <div class="admin-card-description">
                        View and manage student and administrator accounts.
                    </div>

                </div>

                <div class="admin-card-arrow">
                    Open Users →
                </div>

            </a>

        </div>

    </section>


    <!-- SYSTEM STATUS -->
    <section class="admin-section">

        <h2 class="section-title">
            System Status
        </h2>

        <p class="section-description">
            Current status of the administration system.
        </p>


        <div class="system-status-grid">

            <!-- REPORTS -->
            <div class="status-item">

                <div class="status-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M6 3h9l3 3v15H6z" />
                        <path d="M15 3v4h4" />
                        <path d="M9 11h6" />
                        <path d="M9 15h4" />

                    </svg>

                </div>

                <div class="status-text">

                    <div class="status-title">
                        Reports Management
                    </div>

                    <div class="status-description">
                        Administration area is available.
                    </div>

                </div>

                <span class="status-badge">
                    Ready
                </span>

            </div>


            <!-- ITEMS -->
            <div class="status-item">

                <div class="status-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M21 8l-9-5-9 5 9 5 9-5z" />
                        <path d="M3 8v9l9 5 9-5V8" />
                        <path d="M12 13v9" />

                    </svg>

                </div>

                <div class="status-text">

                    <div class="status-title">
                        Items Management
                    </div>

                    <div class="status-description">
                        Administration area is available.
                    </div>

                </div>

                <span class="status-badge">
                    Ready
                </span>

            </div>


            <!-- USERS -->
            <div class="status-item">

                <div class="status-icon">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <circle cx="9" cy="7" r="4" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />

                    </svg>

                </div>

                <div class="status-text">

                    <div class="status-title">
                        User Management
                    </div>

                    <div class="status-description">
                        Administration area is available.
                    </div>

                </div>

                <span class="status-badge">
                    Ready
                </span>

            </div>

        </div>


        <!-- REMINDER -->
        <div class="admin-reminder">

            <div class="reminder-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8"
                     stroke-linecap="round"
                     stroke-linejoin="round">

                    <path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z" />
                    <path d="M9 12l2 2 4-4" />

                </svg>

            </div>

            <div class="reminder-text">

                <strong>
                    Administrator reminder
                </strong>

                <span>
                    Review reports carefully and keep item and account information
                    organized for accurate campus records.
                </span>

            </div>

        </div>

    </section>