@model LostAndFoundSystem.Models.Item

@{
    ViewData["Title"] = "Report Item";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4">Report Lost / Found Item</h2>

    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div class="mb-3">
            <label class="form-label font-weight-bold">Item Title</label>
            <input asp-for="Title" class="form-control" placeholder="e.g. Black Leather Wallet" required />
            <span asp-validation-for="Title" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Category</label>
            <select asp-for="CategoryID" class="form-select" required>
                <option value="">-- Select Category --</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        <option value="@cat.CategoryID">@cat.CategoryName</option>
                    }
                }
            </select>
            <span asp-validation-for="CategoryID" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Status</label>
            <select asp-for="Status" class="form-select" required>
                <option value="Lost">Lost (Nawawala)</option>
                <option value="Found">Found (Nahanap)</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Location Found / Last Seen</label>
            <input asp-for="LocationFound" class="form-control" placeholder="e.g. Library 2nd Floor" required />
            <span asp-validation-for="LocationFound" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Description</label>
            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Provide detailed description of the item..."></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label font-weight-bold">Upload Image (Optional)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-success">Submit Report</button>
        </div>
    </form>
</div>