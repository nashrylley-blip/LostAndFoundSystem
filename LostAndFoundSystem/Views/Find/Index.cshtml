@model List<LostAndFoundSystem.Models.Item>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Find Items";
    var categories = ViewBag.Categories as List<LostAndFoundSystem.Models.Category> ?? new();
    string? searchString = ViewBag.SearchString as string;
    int? categoryId = ViewBag.CategoryId as int?;
    string? status = ViewBag.Status as string;
    int totalItems = ViewBag.TotalItems ?? Model?.Count ?? 0;
}

<style>
    .find-page { max-width: 1400px; margin: 0 auto; padding: 30px; color: #123b61; }
    .find-header {
        position: relative; overflow: hidden;
        background: linear-gradient(135deg, #72d3ee, #43b5df);
        color: white; border-radius: 28px; padding: 42px 45px; margin-bottom: 28px;
        box-shadow: 0 12px 30px rgba(50,157,202,0.14);
    }
    .find-header h1 { margin: 0 0 8px; font-size: 38px; font-weight: 850; letter-spacing: -0.8px; }
    .find-header p { margin: 0; font-size: 15px; line-height: 1.6; opacity: 0.95; }
    .search-card {
        background: white; border: 1px solid #d8e8f1; border-radius: 24px; padding: 30px;
        margin-bottom: 25px; box-shadow: 0 10px 25px rgba(55,111,145,0.055);
    }
    .search-row { display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 14px; align-items: end; }
    .form-group label { display: block; font-size: 12px; font-weight: 800; color: #5a7388; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .03em; }
    .form-control {
        width: 100%; padding: 12px 16px; border-radius: 12px; border: 1px solid #d0e0ec;
        font-size: 14px; color: #17324d; background: #f7fbfe; box-sizing: border-box;
    }
    .btn-search {
        padding: 12px 24px; border-radius: 12px; border: none; background: #159dcc; color: white;
        font-weight: 800; font-size: 14px; cursor: pointer; white-space: nowrap;
    }
    .btn-search:hover { background: #1289b3; }
    .alert-success { background: #e8f8ef; color: #1a7a45; border: 1px solid #b8e6c9; padding: 14px 18px; border-radius: 14px; margin-bottom: 20px; font-weight: 600; }
    .alert-danger { background: #fdecea; color: #b42318; border: 1px solid #f5c2c0; padding: 14px 18px; border-radius: 14px; margin-bottom: 20px; font-weight: 600; }
    .results-info { margin-bottom: 18px; font-size: 14px; color: #5a7388; font-weight: 600; }
    .items-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 22px; }
    .item-card {
        background: white; border: 1px solid #e0edf5; border-radius: 20px; overflow: hidden;
        box-shadow: 0 8px 22px rgba(28,61,91,.06); display: flex; flex-direction: column;
    }
    .item-img { width: 100%; height: 180px; object-fit: cover; background: #f0f7fc; }
    .item-img-placeholder { width: 100%; height: 180px; background: #f0f7fc; display: flex; align-items: center; justify-content: center; color: #a0b4c4; font-size: 13px; }
    .item-body { padding: 20px; flex: 1; display: flex; flex-direction: column; }
    .item-title { margin: 0 0 8px; font-size: 17px; font-weight: 900; color: #17324d; }
    .item-meta { font-size: 13px; color: #71879a; margin-bottom: 6px; }
    .badge {
        display: inline-block; padding: 4px 11px; border-radius: 999px; font-size: 11px; font-weight: 800;
        text-transform: uppercase; margin-bottom: 12px;
    }
    .badge-lost { background: #fff3df; color: #c47a0a; }
    .badge-found { background: #e7f4ff; color: #1a6fb5; }
    .item-desc { font-size: 13px; color: #5a7388; line-height: 1.55; margin-bottom: 16px; flex: 1;
        display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .claim-form { margin-top: auto; border-top: 1px solid #eef3f8; padding-top: 14px; }
    .claim-form textarea {
        width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid #d0e0ec;
        font-size: 13px; resize: vertical; min-height: 60px; box-sizing: border-box; margin-bottom: 10px;
    }
    .btn-claim {
        width: 100%; padding: 11px; border-radius: 11px; border: none; background: #159dcc; color: white;
        font-weight: 800; font-size: 13px; cursor: pointer;
    }
    .btn-claim:hover { background: #1289b3; }
    .empty-state { text-align: center; padding: 60px 20px; color: #7890a4; background: white; border-radius: 24px; border: 1px solid #e0edf5; }
    .empty-state h3 { margin: 0 0 8px; color: #17324d; font-weight: 800; }
    @@media (max-width: 900px) {
        .search-row { grid-template-columns: 1fr; }
    }
</style>

<div class="find-page">
    <div class="find-header">
        <h1>Find Items</h1>
        <p>Search approved lost and found items. Submit a claim if you believe an item belongs to you.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="search-card">
        <form method="get" asp-action="Index">
            <div class="search-row">
                <div class="form-group">
                    <label>Search</label>
                    <input type="text" name="searchString" class="form-control" value="@searchString"
                           placeholder="Item name, description, or location..." />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select name="categoryId" class="form-control">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            if (categoryId == cat.CategoryID)
                            {
                                <option selected value="@cat.CategoryID">@cat.CategoryName</option>
                            }
                            else
                            {
                                <option value="@cat.CategoryID">@cat.CategoryName</option>
                            }
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <select name="status" class="form-control">
                        <option value="">All Types</option>
                        @if (status == "Lost")
                        {
                            <option value="Lost" selected>Lost</option>
                        }
                        else
                        {
                            <option value="Lost">Lost</option>
                        }
                        @if (status == "Found")
                        {
                            <option value="Found" selected>Found</option>
                        }
                        else
                        {
                            <option value="Found">Found</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>&nbsp;</label>
                    <button type="submit" class="btn-search">Search</button>
                </div>
            </div>
        </form>
    </div>

    <div class="results-info">@totalItems @(totalItems == 1 ? "item" : "items") available</div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <h3>No items found</h3>
            <p>Try adjusting your search filters or check back later.</p>
        </div>
    }
    else
    {
        <div class="items-grid">
            @foreach (var item in Model)
            {
                <div class="item-card">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" alt="@item.Title" class="item-img" />
                    }
                    else
                    {
                        <div class="item-img-placeholder">No Image</div>
                    }
                    <div class="item-body">
                        <span class="badge @(item.Status == "Lost" ? "badge-lost" : "badge-found")">@item.Status</span>
                        <h3 class="item-title">@item.Title</h3>
                        <div class="item-meta">📁 @(item.Category?.CategoryName ?? "Uncategorized")</div>
                        <div class="item-meta">📍 @item.LocationFound</div>
                        <div class="item-meta">📅 @item.DateReported.ToString("MMM dd, yyyy")</div>
                        <p class="item-desc">@item.Description</p>

                        <form asp-action="Claim" method="post" class="claim-form"
                              onsubmit="return confirm('Submit a claim for this item?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@item.ItemID" />
                            <textarea name="proofOfOwnership" placeholder="Describe why this item is yours (color, unique marks, when/where you lost it...)" required></textarea>
                            <button type="submit" class="btn-claim">Claim This Item</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
