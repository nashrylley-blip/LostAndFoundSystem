@model List<LostAndFoundSystem.Models.Notification>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin Notifications";
    int unread = ViewBag.UnreadCount ?? 0;
    var items = ViewBag.Items as Dictionary<int, LostAndFoundSystem.Models.Item>
                ?? new Dictionary<int, LostAndFoundSystem.Models.Item>();
}

<style>
    .notif-page { max-width: 900px; margin: 0 auto; padding: 30px; color: #17324d; }
    .notif-header {
        background: linear-gradient(135deg, #72d3ee, #43b5df); color: white;
        border-radius: 28px; padding: 36px 40px; margin-bottom: 24px;
        box-shadow: 0 12px 30px rgba(50,157,202,0.14);
        display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;
    }
    .notif-header h1 { margin: 0 0 6px; font-size: 32px; font-weight: 900; }
    .notif-header p { margin: 0; opacity: .95; font-size: 14px; }
    .btn-mark-all {
        padding: 11px 20px; border-radius: 12px; border: none; background: rgba(255,255,255,.22);
        color: white; font-weight: 800; font-size: 13px; cursor: pointer;
    }
    .btn-mark-all:hover { background: rgba(255,255,255,.32); }
    .alert-success { background: #e8f8ef; color: #1a7a45; border: 1px solid #b8e6c9; padding: 14px 18px; border-radius: 14px; margin-bottom: 18px; font-weight: 600; }
    .notif-list { display: flex; flex-direction: column; gap: 12px; }
    .notif-card {
        background: white; border: 1px solid #e0edf5; border-radius: 18px; padding: 20px 22px;
        box-shadow: 0 6px 18px rgba(28,61,91,.05); display: flex; gap: 16px; align-items: flex-start;
    }
    .notif-card.unread { border-left: 4px solid #159dcc; background: #f7fcff; }
    .notif-icon {
        width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 18px; flex-shrink: 0;
    }
    .type-Report { background: #e7f4ff; }
    .type-Claim { background: #fff3df; }
    .type-Message { background: #f0eaff; }
    .type-System { background: #eef3f8; }
    .notif-body { flex: 1; min-width: 0; }
    .notif-title { margin: 0 0 4px; font-size: 15px; font-weight: 800; color: #17324d; }
    .notif-msg { margin: 0 0 8px; font-size: 13px; color: #5a7388; line-height: 1.5; }
    .notif-meta { font-size: 12px; color: #94a8b8; font-weight: 600; }
    .notif-actions { display: flex; gap: 8px; flex-shrink: 0; }
    .btn-sm {
        padding: 7px 12px; border-radius: 9px; border: none; font-size: 12px; font-weight: 700; cursor: pointer;
    }
    .btn-view { background: #e7f4ff; color: #1a6fb5; }
    .btn-view:hover { background: #d3eaff; }
    .btn-del { background: #fdecea; color: #b42318; }
    .btn-del:hover { background: #fbd9d5; }
    .empty { text-align: center; padding: 60px 20px; background: white; border-radius: 20px; border: 1px solid #e0edf5; color: #7890a4; }
    .empty h3 { margin: 0 0 8px; color: #17324d; font-weight: 800; }

    /* ===== Expandable details ===== */
    .notif-details {
        display: none; margin-top: 14px; padding: 14px; border-radius: 14px;
        background: #f3f9fd; border: 1px solid #dcebf4;
    }
    .notif-details.open { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
    .detail-img {
        width: 120px; height: 120px; object-fit: cover; border-radius: 12px;
        border: 1px solid #d3e4ef; background: white; flex-shrink: 0; cursor: zoom-in;
    }
    .detail-noimg {
        width: 120px; height: 120px; border-radius: 12px; border: 1px dashed #c3d6e3;
        display: flex; align-items: center; justify-content: center; text-align: center;
        font-size: 11px; color: #94a8b8; font-weight: 600; flex-shrink: 0;
    }
    .detail-info { flex: 1; min-width: 200px; font-size: 13px; color: #35516a; }
    .detail-info h4 { margin: 0 0 8px; font-size: 15px; font-weight: 800; color: #17324d; }
    .detail-row { display: flex; gap: 8px; margin-bottom: 4px; line-height: 1.45; }
    .detail-label { min-width: 88px; color: #7890a4; font-weight: 700; }
    .detail-value { flex: 1; word-break: break-word; }
    .badge-status { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; }
    .badge-Pending { background: #fff3df; color: #b26a00; }
    .badge-Approved { background: #e8f8ef; color: #1a7a45; }
    .badge-Rejected { background: #fdecea; color: #b42318; }
    .detail-link {
        display: inline-block; margin-top: 10px; padding: 7px 14px; border-radius: 9px;
        background: #159dcc; color: white; font-size: 12px; font-weight: 700; text-decoration: none;
    }
    .detail-link:hover { background: #1189b3; color: white; }
</style>

<div class="notif-page">
    @* One token used by the fetch() call that marks a notification as read *@
    <form id="tokenForm" style="display:none">@Html.AntiForgeryToken()</form>

    <div class="notif-header">
        <div>
            <h1>Admin Notifications</h1>
            <p id="unreadText">@unread unread notification@(unread == 1 ? "" : "s")</p>
        </div>
        @if (unread > 0)
        {
            <form asp-action="MarkAllRead" method="post" id="markAllForm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-mark-all">Mark all as read</button>
            </form>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty">
            <h3>No notifications yet</h3>
            <p>Updates about reports, claims, and messages will appear here.</p>
        </div>
    }
    else
    {
        <div class="notif-list">
            @foreach (var n in Model)
            {
                LostAndFoundSystem.Models.Item? item = null;
                if (n.RelatedItemID.HasValue)
                {
                    items.TryGetValue(n.RelatedItemID.Value, out item);
                }

                <div class="notif-card @(n.IsRead ? "" : "unread")" data-id="@n.NotificationID">
                    <div class="notif-icon type-@n.Type">
                        @(n.Type switch { "Report" => "📋", "Claim" => "🔑", "Message" => "💬", _ => "🔔" })
                    </div>

                    <div class="notif-body">
                        <h3 class="notif-title">@n.Title</h3>
                        <p class="notif-msg">@n.Message</p>
                        <div class="notif-meta">@n.CreatedAt.ToString("MMM dd, yyyy · hh:mm tt") · @n.Type</div>

                        @if (item != null)
                        {
                            <div class="notif-details">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <a href="@item.ImageUrl" target="_blank" rel="noopener">
                                        <img src="@item.ImageUrl" alt="@item.Title" class="detail-img" />
                                    </a>
                                }
                                else
                                {
                                    <div class="detail-noimg">No image provided</div>
                                }

                                <div class="detail-info">
                                    <h4>@item.Title</h4>

                                    <div class="detail-row">
                                        <span class="detail-label">Type</span>
                                        <span class="detail-value">@item.Status item</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Category</span>
                                        <span class="detail-value">@(item.Category?.CategoryName ?? "—")</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Location</span>
                                        <span class="detail-value">@(string.IsNullOrWhiteSpace(item.LocationFound) ? "—" : item.LocationFound)</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Description</span>
                                        <span class="detail-value">@(string.IsNullOrWhiteSpace(item.Description) ? "—" : item.Description)</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Reported by</span>
                                        <span class="detail-value">
                                            @(item.ReportedByUser?.FullName ?? "—")
                                            @if (!string.IsNullOrEmpty(item.ReportedByUser?.StudentID))
                                            {
                                                <text>(@item.ReportedByUser!.StudentID)</text>
                                            }
                                        </span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Date reported</span>
                                        <span class="detail-value">@item.DateReported.ToString("MMM dd, yyyy · hh:mm tt")</span>
                                    </div>
                                    <div class="detail-row">
                                        <span class="detail-label">Review status</span>
                                        <span class="detail-value">
                                            <span class="badge-status badge-@item.ApprovalStatus">@item.ApprovalStatus</span>
                                        </span>
                                    </div>

                                    @if (n.Type == "Report")
                                    {
                                        <a class="detail-link" asp-controller="ManageReports" asp-action="Details" asp-route-id="@item.ItemID">Open full report</a>
                                    }
                                    else if (n.Type == "Claim")
                                    {
                                        <a class="detail-link" asp-controller="Claims" asp-action="Index">Review claims</a>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="notif-actions">
                        @if (item != null)
                        {
                            <button type="button" class="btn-sm btn-view" data-id="@n.NotificationID">View</button>
                        }
                        else if (!n.IsRead)
                        {
                            @* No related item to expand (e.g. message / system) - just mark as read *@
                            <form asp-action="MarkRead" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@n.NotificationID" />
                                <button type="submit" class="btn-sm btn-view">Mark read</button>
                            </form>
                        }
                        <form asp-action="Delete" method="post" onsubmit="return confirm('Move this notification to the Recycle Bin? You can restore it later.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.NotificationID" />
                            <button type="submit" class="btn-sm btn-del">Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
    (function () {
        const markReadUrl = '@Url.Action("MarkReadAjax", "AdminNotifications")';
        const token = document.querySelector('#tokenForm input[name="__RequestVerificationToken"]')?.value;
        let unreadCount = @unread;

        function updateUnreadUI() {
            const text = document.getElementById('unreadText');
            if (text) {
                text.textContent = unreadCount + ' unread notification' + (unreadCount === 1 ? '' : 's');
            }
            if (unreadCount <= 0) {
                const markAll = document.getElementById('markAllForm');
                if (markAll) markAll.remove();
            }
        }

        async function markRead(card, id) {
            try {
                const body = new FormData();
                body.append('id', id);
                body.append('__RequestVerificationToken', token);

                const res = await fetch(markReadUrl, { method: 'POST', body: body });
                if (res.ok) {
                    card.classList.remove('unread');
                    unreadCount = Math.max(0, unreadCount - 1);
                    updateUnreadUI();
                }
            } catch (e) {
                console.error('Could not mark notification as read', e);
            }
        }

        document.querySelectorAll('.notif-actions button.btn-view[data-id]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const card = btn.closest('.notif-card');
                const panel = card.querySelector('.notif-details');
                if (!panel) return;

                const isOpen = panel.classList.toggle('open');
                btn.textContent = isOpen ? 'Hide' : 'View';

                // Opening an unread notification marks it as read
                if (isOpen && card.classList.contains('unread')) {
                    markRead(card, btn.dataset.id);
                }
            });
        });
    })();
</script>
}